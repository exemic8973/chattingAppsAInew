{
  "name": "chattingappsainew",
  "version": "1.0.0",
  "description": "Cross-platform instant messenger with room-based chat",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.js & next start -p ${PORT:-3000}",
    "start:frontend": "next start -p ${PORT:-3000}",
    "start:backend": "node server.js",
    "lint": "next lint",
    "server": "node server.js",
    "tunnel": "node setup-tunnels.js",
    "tunnel:advanced": "node setup-tunnels-advanced.js",
    "tunnel:frontend": "lt --port 3000 --subdomain chatapp-frontend",
    "tunnel:backend": "lt --port 3001 --subdomain chatapp-backend",
    "start:tunnel": "npm run tunnel:advanced",
    "tunnel:simple": "npm run tunnel",
    "tunnel:setup": "node tunnel-manager.js --auto",
    "tunnel:monitor": "node monitor-tunnels.js --auto",
    "tunnel:cleanup": "node cleanup-tunnels.js --auto",
    "tunnel:interactive": "node tunnel-manager.js",
    "tunnel:cleanup:interactive": "node cleanup-tunnels.js",
    "tunnel:monitor:interactive": "node monitor-tunnels.js",
    "tunnel:start": "node start-tunnels.js",
    "tunnel:quick": "node setup-tunnels-simple.js",
    "tunnel:validate": "node tunnel-config-validator.js",
    "tunnel:ports": "node tunnel-port-utils.js",
    "tunnel:backup": "node tunnel-backup-utils.js",
    "tunnel:backup:create": "node tunnel-backup-utils.js create",
    "tunnel:backup:list": "node tunnel-backup-utils.js list",
    "tunnel:backup:restore": "node tunnel-backup-utils.js restore",
    "start:prod": "npm run build && npm run server",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "build:prod": "npm run build && npm run server",
    "tunnel:backup:cleanup": "node tunnel-backup-utils.js cleanup",
    "dev:tunnel": "npm run tunnel:setup",
    "setup:tunnels": "node setup-complete.js --auto",
    "setup:tunnels:interactive": "node setup-complete.js"
  },
  "keywords": [
    "chat",
    "messenger",
    "webrtc",
    "video-call",
    "voice-call"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/bcryptjs": "^2.4.6",
    "@types/bootstrap": "^5.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "localtunnel": "^2.0.2",
    "next": "^16.0.1",
    "ngrok": "^5.0.0-beta.2",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/simple-peer": "^9.11.9"
  }
}
