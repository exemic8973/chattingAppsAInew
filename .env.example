# CRITICAL: JWT Secret must be the same across ALL services
# Generate a secure random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Port for the integrated server (Next.js + Socket.IO together)
PORT=3000

# IMPORTANT: Socket.IO runs on the SAME PORT as Next.js in integrated mode
# DO NOT add :3001 or any port number - use the base URL only
NEXT_PUBLIC_SOCKET_URL=https://your-app.zeabur.app

# Frontend URL
CLIENT_URL=https://your-app.zeabur.app
FRONTEND_URL=https://your-app.zeabur.app
NEXT_PUBLIC_FRONTEND_URL=https://your-app.zeabur.app

# Node environment
NODE_ENV=production