# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env.development or .env.production
# Or use .env.local for local development (gitignored)

# ============================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================

# CRITICAL: JWT Secret must be the same across ALL services
# Generate a secure random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Server port
PORT=3000

# Socket.IO URL (use base URL only, no port in production)
NEXT_PUBLIC_SOCKET_URL=https://your-app-domain.com

# Frontend URLs
CLIENT_URL=https://your-app-domain.com
FRONTEND_URL=https://your-app-domain.com
NEXT_PUBLIC_FRONTEND_URL=https://your-app-domain.com

# Node environment (development/production)
# DEVELOPMENT = SQLite database
# PRODUCTION = PostgreSQL database
NODE_ENV=production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# The application automatically uses:
# - SQLite for NODE_ENV=development
# - PostgreSQL for NODE_ENV=production

# For PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/chatapp

# For SQLite (Development):
# No configuration needed - uses chat-new.db file

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================
# LOGGING CONFIGURATION
# ============================================

LOG_LEVEL=info

# ============================================
# QUICK SETUP
# ============================================
# For Development (SQLite):
#   1. Copy to .env.development
#   2. Set NODE_ENV=development
#   3. Set JWT_SECRET
#
# For Production (PostgreSQL):
#   1. Copy to .env.production
#   2. Set NODE_ENV=production
#   3. Set DATABASE_URL or PG* variables
#   4. Set JWT_SECRET
#   5. Configure all URLs with your domain