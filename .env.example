# ============================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================

# CRITICAL: JWT Secret must be the same across ALL services
# Generate a secure random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Port for the integrated server (Next.js + Socket.IO together)
PORT=3000

# IMPORTANT: Socket.IO runs on the SAME PORT as Next.js in integrated mode
# DO NOT add :3001 or any port number - use the base URL only
NEXT_PUBLIC_SOCKET_URL=https://your-app.zeabur.app

# Frontend URL
CLIENT_URL=https://your-app.zeabur.app
FRONTEND_URL=https://your-app.zeabur.app
NEXT_PUBLIC_FRONTEND_URL=https://your-app.zeabur.app

# Node environment (development/production)
NODE_ENV=production

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================

# PostgreSQL Connection String (REQUIRED)
# Format: postgresql://username:password@host:port/database?sslmode=require
# Example: postgresql://user:password@db.example.com:5432/chatapp?sslmode=require
# Zeabur and most cloud providers will provide this automatically
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# Alternative individual parameters (fallback if DATABASE_URL not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=chatapp
PGUSER=postgres
PGPASSWORD=your-postgres-password

# ============================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

# Rate limiting window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum attempts per window (default: 5)
RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level (error/warn/info/debug)
LOG_LEVEL=info