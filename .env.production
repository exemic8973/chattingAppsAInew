# ============================================
# PRODUCTION ENVIRONMENT - PostgreSQL
# ============================================

# CRITICAL: JWT Secret must be the same across ALL services
# Generate a secure random string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token expiration time
JWT_EXPIRES_IN=7d

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Production server port
PORT=3000

# Socket.IO URL (your production domain - NO port number)
NEXT_PUBLIC_SOCKET_URL=https://your-app-domain.com

# Frontend URLs
CLIENT_URL=https://your-app-domain.com
FRONTEND_URL=https://your-app-domain.com
NEXT_PUBLIC_FRONTEND_URL=https://your-app-domain.com

# Node environment
NODE_ENV=production

# ============================================
# DATABASE CONFIGURATION - PostgreSQL (Production)
# ============================================

# PostgreSQL Connection String (REQUIRED for production)
# Format: postgresql://username:password@host:port/database?sslmode=require
# Example: postgresql://user:password@db.example.com:5432/chatapp?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp

# Alternative individual parameters (fallback if DATABASE_URL not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=chatapp
PGUSER=postgres
PGPASSWORD=your-postgres-password

# Database Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================
# LOGGING CONFIGURATION
# ============================================

LOG_LEVEL=info
