# PostgreSQL Environment Configuration for Production
# Copy this to .env.local when ready to use PostgreSQL

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================

# PostgreSQL Connection String (Recommended - use this for production)
# Format: postgresql://username:password@host:port/database?sslmode=require
# Example: postgresql://chatapp_user:password@localhost:5432/chattingapp_new?sslmode=require
DATABASE_URL=postgresql://chatapp_user:your_secure_password@localhost:5432/chattingapp_new

# Alternative individual parameters (if DATABASE_URL not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=chattingapp_new
PGUSER=chatapp_user
PGPASSWORD=your_secure_password_here

# SSL Configuration (recommended for production)
# sslmode=require for production, sslmode=disable for development
PGSSLMODE=require

# ============================================
# DATABASE CONNECTION POOL SETTINGS
# ============================================

# Maximum number of connections in the pool
DB_POOL_MAX=20

# Idle timeout before closing connections (milliseconds)
DB_IDLE_TIMEOUT=30000

# Connection timeout (milliseconds)
DB_CONNECTION_TIMEOUT=2000

# ============================================
# SECURITY NOTES
# ============================================
# 1. Always use strong passwords for PostgreSQL
# 2. Enable SSL/TLS for production (sslmode=require)
# 3. Never commit passwords to version control
# 4. Use environment variables or secure vaults for production
# 5. Consider using connection pooling (PgBouncer) for high traffic